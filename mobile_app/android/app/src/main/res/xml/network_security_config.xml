<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly block all cleartext HTTP traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust ONLY official system root certificates; ignore user-installed proxy certs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

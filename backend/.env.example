# Core Application Environment
ENVIRONMENT=development
PORT=8000
CORS_ALLOWED_ORIGINS=https://asiverticals.me,http://localhost:3000

# Database & Supabase Integration (Render FastAPI Backend ONLY)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=ur-heart-auth
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ur-heart-auth.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n"

# AI KYC Microservice (Groq Llama-3 & Whisper)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Monetization & Server-Side Verification (SSV)
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
APPLOVIN_SDK_KEY=your_applovin_s2s_secret_key_here
GOOGLE_VERIFIER_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Internal JWT Signer for WebSocket Handshakes
INTERNAL_JWT_SECRET=your-internal-hmac-jwt-secret-key-here

# Field-Level Data Encryption at Rest (AES-256 GCM Base64 Encoded 32-Byte Key)
DATA_ENCRYPTION_KEY_BASE64=your-base64-encoded-32-byte-encryption-key

